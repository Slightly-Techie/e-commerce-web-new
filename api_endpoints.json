{
  "apiInfo": {
    "title": "E-commerce API",
    "description": "API for managing an e-commerce platform including products, users, orders, and more",
    "baseUrl": "https://ecommerce-api-2-4aq8.onrender.com",
    "version": "v1"
  },
  "endpoints": {
    "authentication": {
      "login": {
        "path": "/auth/login/",
        "method": "POST",
        "description": "Authenticate a user and return a token",
        "requestBody": {
          "email": "string",
          "password": "string"
        },
        "responses": {
          "200": {
            "description": "Successfully authenticated",
            "content": {
              "token": "string"
            }
          },
          "401": {
            "description": "Authentication failed"
          }
        }
      },
      "signup": {
        "path": "/auth/signup/",
        "method": "POST",
        "description": "Register a new user",
        "requestBody": {
          "email": "string",
          "password": "string",
          "firstName": "string",
          "lastName": "string"
        },
        "responses": {
          "201": {
            "description": "User successfully created"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      },
      "logout": {
        "path": "/auth/logout/",
        "method": "POST",
        "description": "Logout the current user",
        "responses": {
          "200": {
            "description": "Successfully logged out"
          }
        }
      },
      "forgetPassword": {
        "path": "/auth/forget-password",
        "method": "POST",
        "description": "Request password reset for a user",
        "requestBody": {
          "email": "string"
        },
        "responses": {
          "200": {
            "description": "Password reset email sent"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      },
      "resetPassword": {
        "path": "/auth/reset-password",
        "method": "POST",
        "description": "Reset user password with token",
        "requestBody": {
          "token": "string",
          "password": "string",
          "confirmPassword": "string"
        },
        "responses": {
          "200": {
            "description": "Password reset successful"
          },
          "400": {
            "description": "Invalid input or token"
          }
        }
      },
      "getProfile": {
        "path": "/auth/profile/{id}",
        "method": "GET",
        "description": "Get user profile information",
        "parameters": {
          "path": {
            "id": "string (optional)"
          }
        },
        "responses": {
          "200": {
            "description": "User profile retrieved",
            "content": "user profile object"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "updateProfile": {
        "path": "/auth/profile/",
        "method": "PUT",
        "description": "Update user profile information",
        "requestBody": {
          "firstName": "string",
          "lastName": "string",
          "email": "string",
          "phoneNumber": "string",
          "address": "object"
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      },
      "createProfile": {
        "path": "/auth/profile/",
        "method": "POST",
        "description": "Create user profile information",
        "requestBody": {
          "firstName": "string",
          "lastName": "string",
          "email": "string",
          "phoneNumber": "string",
          "address": "object"
        },
        "responses": {
          "201": {
            "description": "Profile created successfully"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "products": {
